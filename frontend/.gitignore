# ================================================================= #
#  Node.js and Dependency Cache
# ================================================================= #
# Ignore the folder where all the project's dependencies are installed.
# This folder is generated by running `npm install` or `yarn install`.
node_modules/
.next/

# Ignore package manager lockfiles if you have a specific team policy,
# but it is STRONGLY RECOMMENDED to commit them.
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


# ================================================================= #
#  Vite-specific Files
# ================================================================= #
# Ignore the default build output directory.
dist/

# Ignore the Vite development server cache directory. This speeds
# up server start times but is specific to your local machine.
.vite/


# ================================================================= #
#  Environment Variables
# ================================================================= #
# Ignore all local environment variable files. These often contain
# sensitive API keys and should never be committed to the repository.
# Only commit template files like `.env.example`.
.env.local
.env.*.local


# ================================================================= #
#  Development and Build Logs
# ================================================================= #
# Ignore log files generated by npm, yarn, or other tools.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ================================================================= #
#  IDE and Editor Directories
# ================================================================= #
# Ignore configuration files for popular code editors.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# ================================================================= #
#  Testing
# ================================================================= #
# Ignore test coverage reports. These are generated locally when
# you run your tests.
coverage/
.nyc_output/


# ================================================================= #
#  Operating System Files
# ================================================================= #
# Ignore system-specific files that are automatically generated.
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump