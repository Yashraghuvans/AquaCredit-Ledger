# =============== Root .gitignore ===============
# This file is for ignoring files and folders common to the entire project.

# IDE and Editor-specific files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Log files at the root level
*.log

# Root-level environment variables
# Useful for scripts or tools run from the root.
.env
.env.local